# NASA FIRMS API Configuration
# Obtain a free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key_here

# Default FIRMS dataset source (VIIRS_SNPP_NRT, VIIRS_NOAA20_NRT, or MODIS_NRT)
FIRMS_DEFAULT_SOURCE=VIIRS_SNPP_NRT

# Cache TTL in seconds to prevent hitting NASA FIRMS rate limits (default: 300s = 5 mins)
FIRMS_CACHE_TTL_SECONDS=300
